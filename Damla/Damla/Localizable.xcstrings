{
  "sourceLanguage": "en",
  "strings": {
    "common.ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamam"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "common.notNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi değil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt nicht"
          }
        }
      }
    },
    "dmg.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move it to Applications first"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce Applications klasörüne taşıyın"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst in „Programme“ bewegen"
          }
        }
      }
    },
    "dmg.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag Damla to your Applications folder and open it from there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Damla'yı Uygulamalar klasörüne sürükleyip oradan açın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe Damla in den Ordner „Programme“ und öffne es von dort."
          }
        }
      }
    },
    "login.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Damla when you log in?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Damla oturum açılınca arka planda başlasın mı?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damla beim Anmelden im Hintergrund starten?"
          }
        }
      }
    },
    "login.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Damla runs a small helper in the background that downloads videos. Let it open automatically when you log in. You can turn it off any time in System Settings › General › Login Items."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Damla, videoları indiren küçük bir yardımcıyı arka planda çalıştırır. Mac'inize girişte kendiliğinden açılmasına izin verirseniz Terminal'e gerek kalmaz. Sistem Ayarları › Genel › Giriş Öğeleri'nden istediğiniz zaman kapatabilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damla führt im Hintergrund einen kleinen Helfer aus, der Videos lädt. Erlaubst du den automatischen Start bei der Anmeldung, brauchst du das Terminal nicht. Du kannst ihn jederzeit unter Systemeinstellungen › Allgemein › Anmeldeobjekte ausschalten."
          }
        }
      }
    },
    "login.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben"
          }
        }
      }
    },
    "login.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't turn it on"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlatılamadı"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht aktiviert werden"
          }
        }
      }
    },
    "approval.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow it in System Settings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları'nda izin verin"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Systemeinstellungen erlauben"
          }
        }
      }
    },
    "approval.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Damla under Login Items."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş Öğeleri'nde “Damla” için arka plan iznini açın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Damla“ unter Anmeldeobjekte."
          }
        }
      }
    },
    "approval.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları Aç"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnen"
          }
        }
      }
    },
    "extension.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the extension in Safari"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklentiyi Safari'de açın"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterung in Safari aktivieren"
          }
        }
      }
    },
    "extension.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Safari Settings › Extensions, enable Damla and allow it on the sites you use."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari Ayarları › Uzantılar bölümünde “Damla”yı etkinleştirin ve kullandığınız sitelere erişim izni verin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Damla in den Safari-Einstellungen unter Erweiterungen und erlaube den Zugriff auf die Websites, die du nutzt."
          }
        }
      }
    },
    "extension.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Safari Settings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari Ayarlarını Aç"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari-Einstellungen öffnen"
          }
        }
      }
    },
    "status.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Damla is running"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Damla çalışıyor"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damla läuft"
          }
        }
      }
    },
    "status.running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@. The helper is running in the background."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm %@. Yardımcı arka planda çalışıyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@. Der Helfer läuft im Hintergrund."
          }
        }
      }
    },
    "status.stopped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@. The helper is not running right now."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm %@. Yardımcı şu an çalışmıyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@. Der Helfer läuft gerade nicht."
          }
        }
      }
    },
    "status.check": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri Denetle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Updates suchen"
          }
        }
      }
    },
    "status.quit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Damla"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Damla'yı Kapat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damla beenden"
          }
        }
      }
    }
  },
  "version": "1.0"
}
