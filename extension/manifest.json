{
  "manifest_version": 3,
  "name": "Damla",
  "version": "0.5.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "author": "Kaan Karaman",
  "homepage_url": "https://github.com/kaanrkaraman/damla",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["i18n.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "browser_specific_settings": { "safari": { "strict_min_version": "17.0" } }
}
